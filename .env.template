# =============================================================================
# forecast-bot environment variables (local runs only)
#
#   cp .env.template .env    # .env is git-ignored; never commit it
#
# On GitHub Actions do NOT use a file: add keys under
# Settings -> Secrets and variables -> Actions -> Secrets.
# =============================================================================

# ---- REQUIRED ----------------------------------------------------------------
# Metaculus BOT account token (settings -> My Forecasting Bots).
METACULUS_TOKEN=REPLACE_ME
# OpenRouter key. Keep auto top-up OFF on openrouter.ai. A key without a
# spending limit still runs; pacing then assumes ASSUMED_BUDGET_USD in total.
OPENROUTER_API_KEY=REPLACE_ME

# ---- OPTIONAL ----------------------------------------------------------------
# AskNews news search (added to the web research when both are set).
# Not used by default (signing up needs full name + LinkedIn).
# ASKNEWS_CLIENT_ID=REPLACE_ME
# ASKNEWS_SECRET=REPLACE_ME

# ---- SWITCHES (GitHub: repository *variables*, not secrets) -------------------
# Only the value 1 turns a switch on; any other non-empty value fails the run.
# BOT_ENABLED=1             # scheduled runs happen (manual runs ignore it)
# PUBLISH=1                 # send forecasts + comments. Unset = dry run.
# DRY_RUN_LLM=1             # manual tournament dry run also runs the AI ...
# DRY_RUN_LLM_MAX_QUESTIONS=2   # ... on at most this many questions
# TEST_MAX_QUESTIONS=3      # Test Bot: questions per run

# ---- MODELS AND BUDGET (all optional) ---------------------------------------
# MAIN_FORECAST_MODEL=openai/gpt-6.1-sol         # falls back to openai/gpt-5.6-terra, then openai/gpt-5.4
# MINIBENCH_FORECAST_MODEL=openai/gpt-6.1-sol
# ASSUMED_BUDGET_USD=100    # only used when the key has no spending limit
# BUDGET_STOP_BELOW=3       # USD left -> no LLM calls
# BUDGET_RESERVE=3          # USD kept aside when pacing
# BUDGET_SPLIT_DATE=2026-11-01   # after this date the main tournament gets ...
# MAIN_BUDGET_SHARE=0.8     # ... this share; MiniBench uses the cheapest tier
# MAIN_QUESTIONS_PER_DAY=4
# MINIBENCH_QUESTIONS_PER_DAY=4
# SEASON_END=2027-01-01
# BINARY_MIN=0.03
# BINARY_MAX=0.97
# MC_MIN_PROB=0.01
# BOT_USERNAME=             # for the standings check; read from the token if unset
