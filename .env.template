# =============================================================================
# forecast-bot environment variables (local runs only)
#
#   cp .env.template .env    # .env is git-ignored; never commit it
#
# On GitHub Actions do NOT use a file: add keys under
# Settings -> Secrets and variables -> Actions -> Secrets.
# =============================================================================

# ---- REQUIRED ----------------------------------------------------------------
# Metaculus BOT account token (settings -> My Forecasting Bots).
METACULUS_TOKEN=REPLACE_ME
# OpenRouter key. Give the key a spending LIMIT on openrouter.ai, otherwise the
# bot refuses to run (see ALLOW_UNLIMITED_KEY below).
OPENROUTER_API_KEY=REPLACE_ME

# ---- OPTIONAL ----------------------------------------------------------------
# AskNews news search (added to the web research when both are set).
# ASKNEWS_CLIENT_ID=REPLACE_ME
# ASKNEWS_SECRET=REPLACE_ME

# ---- SWITCHES (GitHub: repository *variables*, not secrets) -------------------
# PUBLISH=1                 # send forecasts + comments. Anything else = dry run.
# ALLOW_UNLIMITED_KEY=1     # run even if the OpenRouter key has no limit
# BUDGET_ECONOMY_BELOW=15   # USD left on the key -> economy mode
# BUDGET_STOP_BELOW=3       # USD left on the key -> no LLM calls
# BINARY_MIN=0.03
# BINARY_MAX=0.97
# MC_MIN_PROB=0.01
# MAX_FORECASTS_PER_RUN=    # empty = defaults described in README
